# No API key is required to run this example.
#
# The agent talks to a local Ollama server through Ajolopy's universal
# OpenAI-compatible provider. The provider's default base URL for the
# `ollama:` prefix is `http://localhost:11434/v1` — install Ollama, run
# `ollama pull llama3.3`, and the example boots without any cloud
# account.

# Optional — only meaningful if you point the universal provider at a
# non-default Ollama endpoint (e.g. a workstation on your LAN). The
# framework does NOT read this variable; it documents the escape hatch
# for users who construct `UniversalOpenAIProvider(base_urls={"ollama":
# "..."})` manually.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional — only consulted when the local Ollama primary fails and the
# cross-provider fallback fires (AJ-72 wires `fallback="claude-haiku-4-5"`
# onto the agent). AJ-69 made fallback provider construction lazy, so
# leaving this unset is fine for development: the example boots and runs
# against the local Ollama daemon without it. Set it before deploying to
# production if you want the cloud fallback path to be reachable.
ANTHROPIC_API_KEY=

# App config
APP_ENV=development
LOG_LEVEL=debug
