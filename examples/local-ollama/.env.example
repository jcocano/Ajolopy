# No API key is required to run this example.
#
# The agent talks to a local Ollama server through Ajolopy's universal
# OpenAI-compatible provider. The provider's default base URL for the
# `ollama:` prefix is `http://localhost:11434/v1` — install Ollama, run
# `ollama pull llama3.3`, and the example boots without any cloud
# account.

# Optional — Ajolopy's universal provider reads this on first request
# (AJ-68). Leave unset to use the baked-in `http://localhost:11434/v1`
# default. Useful for pointing at a remote Ollama daemon, LM Studio
# (`http://127.0.0.1:1234/v1`), vLLM, or any other OpenAI-compatible
# local server without touching code.
OLLAMA_BASE_URL=http://localhost:11434/v1

# App config
APP_ENV=development
LOG_LEVEL=debug
