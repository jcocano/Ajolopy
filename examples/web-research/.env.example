# Primary LLM provider — required to boot.
ANTHROPIC_API_KEY=

# Tavily web search API key. Sign up at https://tavily.com — the free tier
# is generous enough to run the example end-to-end. The agent's `search_web`
# tool reads this at runtime; missing the variable at call time raises
# `TavilyConfigError`. Tests inject a fake client and never need a real key.
TAVILY_API_KEY=

# App config
APP_ENV=development
LOG_LEVEL=debug
