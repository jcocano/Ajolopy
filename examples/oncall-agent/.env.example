# Primary LLM provider — required to boot.
ANTHROPIC_API_KEY=

# App config
APP_ENV=development
LOG_LEVEL=debug

# Optional. The `Integrations` `@MCP` block reads this when spawning the
# GitHub MCP server (stdio transport). Leave empty to keep the server
# unhealthy at boot; the agent still serves and the local
# `summarize_request` tool still answers.
GITHUB_TOKEN=
