# Primary LLM provider — required to boot.
ANTHROPIC_API_KEY=

# App config
APP_ENV=development
LOG_LEVEL=debug

# Which arc step the AppModule wires up:
#   "single" — Step 1 single Support agent on /chat.
#   "team"   — Step 3 SupportTeam workflow on /chat (default).
SUPPORT_AGENT_MODE=team

# Optional — Step 3 only. The Integrations @MCP block reads this when
# spawning the GitHub MCP server (stdio transport). Leave empty to keep the
# server unhealthy at boot; the workflow still serves without it.
GITHUB_TOKEN=
