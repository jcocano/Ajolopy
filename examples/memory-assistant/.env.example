# Primary LLM provider — required to boot.
ANTHROPIC_API_KEY=

# App config
APP_ENV=development
LOG_LEVEL=debug

# Memory backend URL — the @Agent decorator reads this at import time.
#
#   redis://host:port/db   → RedisMemory (production, ajolopy[redis])
#   rediss://...           → RedisMemory over TLS
#   memory://              → InMemoryMemory (per-process, lost on restart)
#
# The compose file ships a local Redis on the default port; the smoke
# test in tests/ overrides this to `memory://` so it never touches a real
# Redis instance.
REDIS_URL=redis://localhost:6379/0
