"""Entry point. Run with ``ajolopy dev`` or ``python -m {package_name}.main``.

Two public attributes:

- ``ajolopy_app`` — the framework's :class:`AjolopyApp` wrapper. Holds
  the compiled module, the populated DI container, the Starlette HTTP
  app, and the lifecycle manager. Tests use this (they understand the
  wrapper).

- ``app`` — the underlying Starlette ASGI3 callable, suitable for any
  ASGI server (``ajolopy dev``, bare uvicorn, hypercorn, etc.). The
  wrapper itself does not implement the ASGI3 protocol, and uvicorn's
  ``factory=True`` mode does NOT await async factories — it calls them
  synchronously and treats the returned coroutine as the ASGI app,
  which fails. Pre-building the app at import time via
  :func:`asyncio.run` sidesteps both problems.
"""

import asyncio

from ajolopy import AjolopyApp, AjolopyFactory

from {package_name}.app_module import AppModule


async def build_app() -> AjolopyApp:
    """Async factory. Tests + advanced wiring use this path."""
    return await AjolopyFactory.create(AppModule)


# Pre-build once at module import. Production servers mount
# ``{package_name}.main:app`` (the Starlette inner app) directly.
ajolopy_app: AjolopyApp = asyncio.run(build_app())
app = ajolopy_app.http


def main() -> None:
    """Synchronous wrapper for ``python -m {package_name}.main``.

    ``ajolopy_app`` / ``app`` are constructed at import time; nothing
    more to do here for the smoke path. Production servers (uvicorn,
    hypercorn, etc.) mount ``{package_name}.main:app`` directly without
    invoking ``main()``.
    """


if __name__ == "__main__":
    main()
