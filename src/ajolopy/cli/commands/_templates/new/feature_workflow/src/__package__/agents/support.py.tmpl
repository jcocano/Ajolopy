"""Sample @Workflow generated by ``ajolopy new --feature workflow``.

Two specialist :class:`Agent`s (``Triage``, ``Billing``) are coordinated
by a :class:`Workflow` whose ``coordinator=`` is the default LLM model.
The workflow class is exported as ``Support`` so the rest of the
scaffold (``app_module``, tests) stays variant-agnostic.

The ``@Stream("/chat")`` handler lives on the ``@Workflow`` orchestrator
(not on a specialist) so the HTTP wire contract stays identical to the
``--feature agent`` scaffold: clients ``POST /chat`` with
``{{"message": "..."}}`` and consume an SSE stream. The orchestrator
yields :class:`WorkflowEvent` dicts (``handoff``, ``agent_result``,
``token``, ``done``) instead of raw strings; clients must ignore
unknown event ``type`` values. The shape mirrors
``examples/support-agent/src/support_agent/agents/team.py``.
"""

from typing import Annotated

from pydantic import BaseModel

from ajolopy import Agent, Stream, Tool, Workflow
from ajolopy.http import Body


class ChatRequest(BaseModel):
    """Inbound chat payload posted to ``/chat``."""

    message: str


@Agent(
    model="{llm_model}",
    system="You are the triage agent for {class_prefix}. Classify the incoming request.",
)
class Triage:
    """First-line classifier."""

    @Tool
    def classify(self, text: str) -> str:
        """Return the intent label for ``text``. Replace with real logic."""
        return text


@Agent(
    model="{llm_model}",
    system="You are the billing specialist for {class_prefix}.",
)
class Billing:
    """Domain specialist for billing-related requests."""

    @Tool
    def lookup_invoice(self, customer_id: str) -> str:
        """Return the latest invoice id for ``customer_id``. Replace with real logic."""
        return customer_id


@Workflow(
    agents=[Triage, Billing],
    coordinator="{llm_model}",
)
class Support:
    """Multi-agent coordinator for {class_prefix} support requests."""

    @Stream("/chat")
    async def respond(self, body: Annotated[ChatRequest, Body()]):
        """Stream the team's response for ``body.message`` as SSE events."""
        # ``self.stream`` is injected by ``@Workflow`` at decoration time;
        # static analysers cannot see the attribute, so we silence the
        # missing-attribute warning here. Same pattern as
        # ``examples/support-agent/src/support_agent/agents/team.py``.
        async for event in self.stream(body.message):  # type: ignore[attr-defined]
            yield event
