"""Sample @Agent generated by ``ajolopy new --feature agent``.

The shape mirrors the README "killer demo" verbatim: a Pydantic
``ChatRequest`` body, an ``@Agent`` with a ``fallback=`` model, a
single ``@Tool`` with a realistic-looking return shape, and a
``@Stream`` endpoint that pipes the agent's tokens to the HTTP
response. Swap the system prompt, tool body, and request schema
for your own once you start building.
"""

from typing import Annotated

from pydantic import BaseModel

from ajolopy import Agent, Stream, Tool
from ajolopy.http import Body


class ChatRequest(BaseModel):
    """Inbound chat payload posted to ``/chat``."""

    message: str


@Agent(
    model="{llm_model}",
    system="You are {class_prefix}. Be concise, friendly, and accurate.",
    fallback="{llm_fallback}",
)
class Support:
    """The on-call assistant for {class_prefix}."""

    @Tool
    async def lookup_order(self, order_id: str) -> dict[str, str]:
        """Look up an order's current state by id."""
        return {{"order_id": order_id, "status": "in_transit", "eta": "tomorrow"}}

    @Stream("/chat")
    async def respond(self, body: Annotated[ChatRequest, Body()]):
        """Stream a reply for ``body.message`` over the ``/chat`` endpoint."""
        async for chunk in self.stream(body.message):
            yield chunk
