"""``{class_name}Eval`` — generated by ``ajolopy generate eval {name}``."""

from ajolopy import Eval, Metric
from ajolopy.eval.metrics import exact_match

from {package_name}.agents.{snake_name} import {class_name}


@Eval(agent={class_name}, dataset="evals/datasets/{snake_name}.jsonl")
class {class_name}Eval:
    """Smoke-tier evaluation: every prompt echoes back unchanged."""

    @Metric
    def echoed(self, output: str, expected: dict[str, str]) -> float:
        """Score 1.0 when ``output`` matches ``expected['text']`` exactly."""
        return exact_match(output, expected["text"])
