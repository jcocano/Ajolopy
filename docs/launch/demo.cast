[0.0, "o", "[1;36m$ [0majolopy new acme-support\r\n"]
[1.2, "o", "✨ Scaffolding acme-support/ ...\r\n"]
[1.6, "o", "    → anthropic provider (claude-sonnet-4-7)\r\n"]
[1.9, "o", "    → agent + tool + stream defaults\r\n"]
[2.2, "o", "    → .env.example with ANTHROPIC_API_KEY\r\n"]
[2.5, "o", "    → Dockerfile + fly.toml\r\n"]
[2.9, "o", "Done. cd acme-support && uv sync && ajolopy dev\r\n"]
[3.4, "o", "[1;36m$ [0mcat src/acme_support/agents/support.py\r\n"]
[4.0, "o", "from typing import Annotated\r\nfrom pydantic import BaseModel\r\nfrom ajolopy import Agent, Stream, Tool\r\nfrom ajolopy.http import Body\r\n\r\n"]
[4.5, "o", "class ChatRequest(BaseModel):\r\n    message: str\r\n\r\n"]
[5.0, "o", "@Agent(\r\n    model=\"claude-sonnet-4-7\",\r\n    system=\"You are Acme Support.\",\r\n    fallback=\"claude-haiku-4-5\",\r\n)\r\n"]
[5.7, "o", "class Support:\r\n    @Tool\r\n    async def lookup_order(self, order_id: str) -> dict[str, str]:\r\n        return {\"order_id\": order_id, \"status\": \"in_transit\"}\r\n\r\n"]
[6.4, "o", "    @Stream(\"/chat\")\r\n    async def respond(self, body: Annotated[ChatRequest, Body()]):\r\n        async for chunk in self.stream(body.message):\r\n            yield chunk\r\n"]
[8.0, "o", "[1;36m$ [0mcp .env.example .env\r\n"]
[8.4, "o", "[1;36m$ [0mexport ANTHROPIC_API_KEY=sk-ant-...\r\n"]
[8.8, "o", "[1;36m$ [0majolopy dev\r\n"]
[9.5, "o", "[1;32m✓[0m Validating .env ... required vars present\r\n"]
[9.9, "o", "[1;32m✓[0m OpenTelemetry instrumentation: always-on (install ajolopy[otel] for exporters)\r\n"]
[10.3, "o", "Starting Ajolopy dev server...\r\n   App:      acme_support.main:app\r\n   URL:      http://127.0.0.1:8000\r\n   Watching: src/, .env\r\n   Reload:   on\r\n"]
[11.0, "o", "INFO:     Application startup complete.\r\n"]
[12.5, "o", "[1;36m$ [0mcurl -N -X POST http://127.0.0.1:8000/chat -d '{\"message\": \"Where is order 4392? Use the tool.\"}'\r\n"]
[13.4, "o", "data: Let me "]
[13.7, "o", "look "]
[13.9, "o", "that up "]
[14.1, "o", "for you.\r\n"]
[14.6, "o", "data: [tool_use lookup_order(order_id=\"4392\")]\r\n"]
[15.0, "o", "data: [tool_result {\"order_id\":\"4392\",\"status\":\"in_transit\"}]\r\n"]
[15.6, "o", "data: Order "]
[15.9, "o", "4392 is "]
[16.2, "o", "currently in "]
[16.5, "o", "transit. Anything else?\r\n"]
[16.9, "o", "data: [done]\r\n"]
[18.0, "o", "[1;36m$ [0majolopy eval --ci\r\n"]
