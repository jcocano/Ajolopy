# Primary LLM provider — required to boot.
#
# The docsbot routes through OpenRouter via Ajolopy's universal
# OpenAI-compatible provider (model="openrouter:minimax/minimax-m2.5:free"
# with a paid m2.7 fallback). Get a key at https://openrouter.ai/keys.
# The free key supports both the :free model and the paid m2.7 fallback
# (billing is per-model, not per-key).
OPENROUTER_API_KEY=

# App config
APP_ENV=development
LOG_LEVEL=debug
